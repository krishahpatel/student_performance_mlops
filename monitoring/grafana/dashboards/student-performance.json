{
    "id": null,
    "uid": "student-performance",
    "title": "Student Performance Monitoring",
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "tags": [
        "mlops",
        "student-performance"
    ],
    "timezone": "browser",
    "refresh": "15s",
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "Service Scrape Availability",
            "description": "1 = Prometheus can scrape the service; 0 = scrape failed.",
            "type": "stat",
            "gridPos": {
                "h": 5,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "up{job=~\"webapp|dbapp\"}",
                    "instant": true,
                    "legendFormat": "{{job}}",
                    "refId": "A",
                    "hide": false,
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "options": {
                                "0": {
                                    "color": "red",
                                    "text": "DOWN"
                                },
                                "1": {
                                    "color": "green",
                                    "text": "UP"
                                }
                            },
                            "type": "value"
                        }
                    ],
                    "max": 1,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
            },
            "links": [],
            "transformations": [],
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            }
        },
        {
            "id": 2,
            "title": "Predictions Since Webapp Start",
            "description": "Counters reset when the webapp process restarts.",
            "type": "stat",
            "gridPos": {
                "h": 5,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum by (result) (predictions_total{job=\"webapp\"})",
                    "instant": true,
                    "legendFormat": "{{result}}",
                    "refId": "A",
                    "hide": false,
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "decimals": 0,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
