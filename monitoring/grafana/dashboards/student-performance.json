{
    "id": null,
    "uid": "student-performance",
    "title": "Student Performance Monitoring",
    "tags": [
        "mlops",
        "student-performance"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "Service Scrape Availability",
            "description": "1 = Prometheus can scrape the service; 0 = scrape failed.",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "up{job=~\"webapp|dbapp\"}",
                    "legendFormat": "{{job}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 1,
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "red"
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value_and_name",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                }
            }
        },
        {
            "id": 2,
            "title": "Predictions Since Webapp Start",
            "description": "Counters reset when the webapp process restarts.",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 5,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (result) (predictions_total{job=\"webapp\"})",
                    "legendFormat": "{{result}}",
                    "instant": true
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "decimals": 0,
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "textMode": "value_and_name",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                }
            }
        },
        {
            "id": 3,
            "title": "HTTP Requests per Second",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (route, status) (rate(http_requests_total{job=\"webapp\"}[$__rate_interval]))",
                    "legendFormat": "{{route}} - {{status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 4,
            "title": "Prediction Request and Inference Duration — p95",
            "description": "HTTP request duration includes database saving. Inference duration covers predict and predict_proba.",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 5
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"webapp\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
                    "legendFormat": "Prediction HTTP request"
                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(model_inference_duration_seconds_bucket{job=\"webapp\"}[$__rate_interval])))",
                    "legendFormat": "Model inference"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 5,
            "title": "Predictions per Minute",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 13
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (result) (rate(predictions_total{job=\"webapp\"}[$__rate_interval])) * 60",
                    "legendFormat": "{{result}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 6,
            "title": "Prediction Failures in Last 5 Minutes",
            "description": "Estimated increase, grouped by validation or inference stage.",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 13
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (stage) (increase(prediction_failures_total{job=\"webapp\"}[5m]))",
                    "legendFormat": "{{stage}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 7,
            "title": "Database Save Outcomes in Last 5 Minutes",
            "description": "Measured by webapp. Predictions may return HTTP 200 even when saving fails.",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 21
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (outcome) (increase(db_save_attempts_total{job=\"webapp\"}[5m]))",
                    "legendFormat": "{{outcome}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 8,
            "title": "Database Save Request Duration — p95",
            "description": "Webapp HTTP call duration, including failures; not SQLite commit time alone.",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 21
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(db_save_request_duration_seconds_bucket{job=\"webapp\"}[$__rate_interval])))",
                    "legendFormat": "Database save request"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        }
    ]
}