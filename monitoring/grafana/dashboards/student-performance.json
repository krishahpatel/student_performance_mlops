            "title": "HTTP Requests per Second",
            "description": "",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "targets": [
                {
                    "expr": "sum by (route, status) (rate(http_requests_total{job=\"webapp\"}[$__rate_interval]))",
                    "legendFormat": "{{route}} - {{status}}",
                    "refId": "A",
                    "hide": false,
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
